                    ]
                },
                {
                    "id": "items.text",
                    "type": "string",
                    "format": "textarea",
                    "label": {
                        "ar": "نص التقييم",
                        "en": "Review text"
                    },
                    "multilanguage": true,
                    "required": true,
                    "maxLength": 300
