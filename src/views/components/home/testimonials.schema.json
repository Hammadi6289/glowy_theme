                    "multilanguage": true,
                    "required": false,
                    "maxLength": 80
                },
                {
                    "id": "items.picture",
                    "type": "string",
                    "format": "image",
                    "label": {
                        "ar": "صورة العميل",
                        "en": "Customer picture"
                    },
                    "required": false
                },
                {
                    "id": "items.stars",
                    "type": "number",
                    "format": "integer",
                    "label": {
                        "ar": "عدد النجوم",
                        "en": "Stars"
