{
    "key": "falak-contact",
    "path": "home.contact",
    "title": {
        "ar": "نموذج التواصل",
        "en": "Contact Form"
    },
    "icon": "mail-line",
    "is_default": false,
    "areas": [
        "home",
        "pages"
    ],
    "styleable": [
        {
            "id": "title",
            "label": {
                "ar": "عنوان القسم",
                "en": "Section title"
            }
        },
        {
            "id": "subtitle",
            "label": {
                "ar": "العنوان الفرعي",
                "en": "Subtitle"
            }
        },
        {
            "id": "image",
            "label": {
                "ar": "الصورة",
                "en": "Image"
            },
            "properties": [
                "max_width",
                "align_self",
                "border_radius",
                "border_width",
                "border_color"
            ]
        },
        {
            "id": "form",
            "label": {
                "ar": "صندوق النموذج",
                "en": "Form box"
            },
            "properties": [
                "max_width",
                "align_self",
                "text_align",
                "padding_block",
                "padding_inline",
                "background_color",
                "border_radius",
                "border_width",
                "border_color"
            ]
        }
    ],
    "fields": [
        {
            "id": "badge",
            "type": "string",
            "format": "text",
            "label": {
                "ar": "شارة القسم",
                "en": "Section badge"
            },
            "multilanguage": true,
            "required": false,
            "maxLength": 50,
            "value": {
                "ar": "خدمة العملاء",
                "en": "Customer Support"
            }
        },
        {
            "id": "title",
            "type": "string",
            "format": "text",
            "label": {
                "ar": "عنوان القسم",
                "en": "Section title"
            },
            "multilanguage": true,
            "required": false,
            "maxLength": 100,
            "value": {
                "ar": "تواصل معنا",
                "en": "Get in touch"
            }
        },
        {
            "id": "subtitle",
            "type": "string",
            "format": "text",
            "label": {
                "ar": "نص فرعي",
                "en": "Subtitle"
            },
            "multilanguage": true,
            "required": false,
            "maxLength": 140,
            "value": {
                "ar": "سنرد عليك في أقرب وقت",
                "en": "We will get back to you shortly"
            }
        },
        {
            "id": "image",
            "type": "string",
            "format": "image",
            "label": {
                "ar": "صورة النموذج",
                "en": "Form image"
            },
            "description": {
                "ar": "صورة جانبية أو بنر مع نموذج التواصل",
                "en": "Side image or banner for the contact form"
            },
            "required": false
        },
        {
            "id": "image_position",
            "type": "items",
            "format": "dropdown-list",
            "label": {
                "ar": "موقع الصورة",
                "en": "Image position"
            },
            "description": {
                "ar": "تحديد موضع الصورة بجانب النموذج أو كبنر أعلاه أو أسفله",
                "en": "Display the image beside the form or as a top/bottom banner"
            },
            "value": "start",
            "options": [
                {
                    "label": {
                        "ar": "بجانب النموذج (الوضع الافتراضي)",
                        "en": "Side by side (Default)"
                    },
                    "value": "start"
                },
                {
                    "label": {
                        "ar": "بجانب النموذج (الجهة المعكوسة)",
                        "en": "Side by side (Flipped)"
                    },
                    "value": "end"
                },
                {
                    "label": {
                        "ar": "أعلى النموذج (بنر)",
                        "en": "Above form (Banner)"
                    },
                    "value": "top"
                },
                {
                    "label": {
                        "ar": "أسفل النموذج (بنر)",
                        "en": "Below form (Banner)"
                    },
                    "value": "bottom"
                }
            ]
        },
        {
            "id": "show_subject",
            "type": "boolean",
            "format": "switch",
            "label": {
                "ar": "إظهار حقل الموضوع",
                "en": "Show the subject field"
            },
            "value": true
        },
        {
            "id": "show_channels",
            "type": "boolean",
            "format": "switch",
            "label": {
                "ar": "إظهار قنوات التواصل السريعة",
                "en": "Show quick contact channels"
            },
            "description": {
                "ar": "عرض روابط التواصل المباشر (هاتف، واتساب، بريد)",
                "en": "Show direct links for phone, whatsapp, email"
            },
            "value": false
        }
    ]
}
