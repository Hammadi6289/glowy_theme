{#
    Cart page.

    Rendered server-side (right on first paint, works without JS); the SDK
    drives every mutation from app.js — quantity, remove, coupon — and the
    page re-renders afterwards. The customer is known to the server through
    the auth cookie set at sign-in, so this is the same cart the SDK writes.

    | Variable   | Type  | Description                                              |
    | cart_items | array | each: product, variation, quantity, unit_amount,         |
    |            |       | line_total_amount, old_amount                            |
    | cart_total | array | subtotal, discount, discount_code, total (numeric)       |
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('cart.title') }} — {{ store.name }}{% endblock %}

{% block content %}
    <div class="container cart-page" data-cart-page>
        {% if cart_items|length > 0 %}
            <header class="page-head">
                <h1>{{ trans('cart.title') }}</h1>
                <p class="page-head__meta">{{ trans('cart.items_count', {count: cart_items|length}) }}</p>
            </header>

            <div class="cart-layout">
                <ul class="cart-items">
                    {% for item in cart_items %}
                        <li class="cart-item"
                            data-cart-line
                            data-product-id="{{ item.product.id }}"
                            {% if item.variation_id %}data-variation-id="{{ item.variation_id }}"{% endif %}>
                            <a class="cart-item__media" href="{{ item.product.url }}">
                                {# `image` already falls back to the clip's poster server-side,
                                   so the second branch covers only the last case: a
                                   video-commerce product whose merchant uploaded a clip and
                                   never a poster for it. preload="metadata" plus the #t=0.1
                                   fragment paints the first frame for a few kilobytes rather
                                   than pulling the file — a cart of these must not cost
                                   megabytes to draw its thumbs. #}
                                {% if item.product.image %}
                                    <img src="{{ item.product.image }}" alt="{{ item.product.name }}" loading="lazy">
                                {% elseif item.product.video %}
                                    <video class="cart-item__clip" preload="metadata" muted playsinline
                                           tabindex="-1" src="{{ item.product.video }}#t=0.1"></video>
                                {% endif %}
                            </a>

                            <div class="cart-item__info">
                                <a class="cart-item__name" href="{{ item.product.url }}">{{ item.product.name }}</a>
                                {# `variation.options` names the choice the way the
                                   product page did — the merchant's labels, in
                                   their order. The raw attribute map is the
                                   fallback for a cart built before it existed. #}
                                {% if item.variation and item.variation.options is defined and item.variation.options %}
                                    <span class="cart-item__variation">
                                        {%- for option in item.variation.options -%}
                                            {%- if option.display and option.type == 'color' -%}
                                                {{ option.label }}: <i class="cart-item__swatch" role="img"
                                                   aria-label="{{ option.value_label }}"
                                                   title="{{ option.value_label }}"
                                                   style="background: {{ option.display }}"></i>
                                            {%- elseif option.display and option.type == 'image' -%}
                                                {{ option.label }}: <img class="cart-item__swatch cart-item__swatch--image"
                                                     src="{{ option.display }}" loading="lazy"
                                                     alt="{{ option.value_label }}"
                                                     title="{{ option.value_label }}">
                                            {%- else -%}
                                                {{ option.label }}: {{ option.value_label }}
                                            {%- endif -%}
                                            {{- not loop.last ? ' · ' : '' -}}
                                        {%- endfor -%}
                                    </span>
                                {% elseif item.variation and item.variation.attributes is defined and item.variation.attributes %}
                                    <span class="cart-item__variation">
                                        {%- for key, value in item.variation.attributes -%}
                                            {%- if key|lower in ['color', 'colors', 'colour', 'colours'] or key in ['اللون', 'ألوان', 'الوان'] or value starts with '#' -%}
                                                {{ key }}: <span class="cart-item__color-dot" data-color="{{ value }}" style="background-color: {{ value }};" title="{{ value }}" aria-label="{{ value }}"></span><span class="cart-item__color-name">{{ value }}</span>
                                            {%- else -%}
                                                {{ key }}: {{ value }}
                                            {%- endif -%}
                                            {{ not loop.last ? ' · ' : '' }}
                                        {%- endfor -%}
                                    </span>
                                {% endif %}
                                <span class="cart-item__unit">
                                    {{ falak_currency(item.unit_amount) }}
                                    {% if item.old_amount %}<del>{{ falak_currency(item.old_amount) }}</del>{% endif %}
                                </span>
                            </div>

                            <div class="cart-item__qty" role="group" aria-label="{{ trans('cart.quantity') }}">
                                <button type="button" class="cart-item__step" data-cart-qty="down" aria-label="{{ trans('cart.decrease') }}">&minus;</button>
                                <span class="cart-item__qty-value" data-cart-qty-value>{{ item.quantity }}</span>
                                <button type="button" class="cart-item__step" data-cart-qty="up" aria-label="{{ trans('cart.increase') }}">+</button>
                            </div>

                            <span class="cart-item__line-total">{{ falak_currency(item.line_total_amount) }}</span>

                            <button type="button" class="cart-item__remove" data-cart-remove aria-label="{{ trans('cart.remove') }}">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                            </button>
                        </li>
                    {% endfor %}
                </ul>

                <div class="cart-sidebar">
                    <div class="cart-coupon-box">
                        <falak-cart-coupons class="cart-coupon"></falak-cart-coupons>
                    </div>

                    <aside class="cart-summary" aria-label="{{ trans('cart.summary') }}">
                        <h2>{{ trans('cart.summary') }}</h2>

                        {% set vat_amount = cart_total.tax|default(cart_total.vat|default(cart_total.tax_amount|default(0))) %}
                        {% if vat_amount > 0 %}
                            <div class="cart-summary__row">
                                <span>{{ trans('cart.subtotal_excl_vat') }}</span>
                                <span>{{ falak_currency(cart_total.subtotal_excl_vat|default(cart_total.subtotal)) }}</span>
                            </div>
                            <div class="cart-summary__row">
                                <span>{{ trans('cart.vat') }}</span>
                                <span>{{ falak_currency(vat_amount) }}</span>
                            </div>
                        {% else %}
                            <div class="cart-summary__row">
                                <span>{{ trans('cart.subtotal') }}</span>
                                <span>{{ falak_currency(cart_total.subtotal) }}</span>
                            </div>
                        {% endif %}

                        {% if cart_total.product_discount > 0 %}
                            <div class="cart-summary__row cart-summary__row--discount">
                                <span>{{ trans('cart.product_discount') }}</span>
                                <span>&minus; {{ falak_currency(cart_total.product_discount) }}</span>
                            </div>
                        {% endif %}
                        {% if cart_total.discount > 0 %}
                            <div class="cart-summary__row cart-summary__row--discount">
                                <span>{{ trans('cart.discount') }}</span>
                                <span>&minus; {{ falak_currency(cart_total.discount) }}</span>
                            </div>
                        {% endif %}
                        {% if cart_total.special_offer_discount > 0 %}
                            <div class="cart-summary__row cart-summary__row--discount">
                                <span>{{ trans('cart.special_offer') }}</span>
                                <span>&minus; {{ falak_currency(cart_total.special_offer_discount) }}</span>
                            </div>
                        {% endif %}
                        {% if cart_total.free_shipping %}
                            <p class="cart-summary__note">{{ trans('cart.free_shipping') }}</p>
                        {% endif %}

                        {% set items_count = cart_items|length %}
                        <div class="cart-summary__row cart-summary__row--total">
                            <div class="cart-summary__total-label">
                                <span class="cart-summary__total-name">{{ trans('cart.total') }}</span>
                                <span class="cart-summary__total-count">({{ trans('cart.items_suffix', {count: items_count})|default(items_count ~ ' items') }})</span>
                            </div>
                            <span class="cart-summary__total-value">{{ falak_currency(cart_total.total) }}</span>
                        </div>
                        <p class="cart-summary__tax-note">{{ trans('cart.prices_include_vat') }}</p>

                        <a class="btn btn--primary btn--block cart-summary__checkout" href="/checkout">{{ trans('cart.checkout') }}</a>
                    </aside>
                </div>
            </div>
        {% else %}
            <div class="empty-state cart-page__empty">
                <div class="empty-state__icon-wrap">
                    <svg class="empty-state__illustration" viewBox="0 0 260 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <!-- Soft Theme Blob -->
                        <path d="M85 35 C145 20, 210 40, 215 95 C220 150, 160 175, 115 170 C70 165, 45 130, 50 85 C55 45, 60 40, 85 35 Z" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 14%, #ffffff)" />
                        <circle cx="48" cy="115" r="5" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 35%, transparent)" stroke-width="2" fill="none" />
                        <circle cx="56" cy="65" r="10" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 30%, transparent)" stroke-width="2" fill="none" />
                        <circle cx="215" cy="48" r="8" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 30%, transparent)" stroke-width="2" fill="none" />
                        <circle cx="68" cy="180" r="3.5" fill="#e59866" />
                        <path d="M175 185 C190 190, 200 175, 210 180 C215 182, 222 175, 228 178" stroke="#e59866" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />
                        <circle cx="225" cy="160" r="11" fill="#e59866" />
                        <path d="M221 156 L229 164 M229 156 L221 164" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />

                        <!-- Theme Primary Shopping Cart -->
                        <g class="empty-state__cart-group">
                            <path d="M68 76 H78 L92 142 C93 147, 97 150, 102 150 H184 C189 150, 193 147, 194 142 L206 95 H83" stroke="var(--color-primary, #ce5a67)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.2" />
                            <path d="M68 76 H78 L92 142 C93 147, 97 150, 102 150 H184 C189 150, 193 147, 194 142 L206 95 H83" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 38%, #ffffff)" />
                            <rect x="106" y="104" width="46" height="6.5" rx="3.25" fill="#ffffff" />
                            <rect x="112" y="120" width="46" height="6.5" rx="3.25" fill="#ffffff" />
                            <circle cx="112" cy="165" r="13" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 42%, #ffffff)" />
                            <circle cx="174" cy="165" r="13" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 42%, #ffffff)" />
                            <circle cx="196" cy="90" r="19" fill="var(--color-primary, #ce5a67)" />
                            <path d="M189 83 L203 97 M203 83 L189 97" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" />
                        </g>
                    </svg>
                </div>
                <p class="empty-state__text">{{ trans('cart.empty') }}</p>
                <a href="/products" class="btn btn--primary">
                    {{ trans('cart.start_shopping') }}
                </a>
            </div>
            <falak-placeholder data-cart-empty style="display:none;" icon="" text="{{ trans('cart.empty') }}"
                               action-text="{{ trans('cart.start_shopping') }}" action-href="/products"
                               action-class="btn btn--primary"></falak-placeholder>
        {% endif %}
    </div>
{% endblock %}
