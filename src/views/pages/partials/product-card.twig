{#
    Product card — shared by listing, search, brand and wishlist pages.
    Expects `product`: id, name, price (formatted), image, url.
    The name link stretches over the card; the buy button sits above it.
#}
<div class="product-card">
    <div class="product-card__media-wrap">
        <a class="product-card__media" href="{{ product.url }}">
            {% if product.image %}
                <img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy">
            {% else %}
                <span class="product-card__placeholder" aria-hidden="true">🛍</span>
            {% endif %}
        </a>

        <div class="product-card__actions">
            <div class="product-card__quick-actions">
                <a href="{{ product.url }}" class="btn--card-icon btn--card-quickview" aria-label="{{ trans('product.view')|default('View') }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
                <falak-wishlist-button product-id="{{ product.id }}" button-class="btn btn--card-icon"></falak-wishlist-button>
                {% if theme.settings.get('compare_enabled', true) %}
                    <button class="btn btn--card-icon btn--card-compare" type="button" data-compare-toggle="{{ product.id }}" aria-pressed="false" aria-label="{{ trans('compare.add') }}">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v10m0 0-3-3m3 3 3-3M17 20V10m0 0-3 3m3-3 3 3M4 20h6M14 4h6"/></svg>
                    </button>
                {% endif %}
                <button class="btn--card-icon btn--card-share" type="button" data-share-url="{{ product.url }}" aria-label="{{ trans('common.share')|default('Share') }}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
            </div>

            <falak-add-product-button product-id="{{ product.id }}"
                                      product-status="{{ (product.in_stock is defined and not product.in_stock) ? 'out' : 'sale' }}"
                                      {{ product.has_variations|default(false) ? 'has-options' : '' }}
                                      product-name="{{ product.name }}"
                                      product-image="{{ product.image }}"
                                      product-price="{{ product.price }}"
                                      {% if product.price_amount is defined %}product-price-amount="{{ product.price_amount }}"{% endif %}
                                      {% if product.compare_at_amount is defined and product.compare_at_amount %}product-compare-price="{{ product.compare_at_amount }}"
                                      {% elseif product.compare_at %}product-compare-price="{{ product.compare_at }}"{% endif %}
                                      {% if product.currency %}product-currency="{{ product.currency }}"{% endif %}
                                      product-url="{{ product.url }}"
                                      {% if product.in_stock is defined %}product-in-stock="{{ product.in_stock ? 'true' : 'false' }}"{% endif %}
                                      {% if product.category %}product-subtitle="{{ product.category.name }}"{% endif %}
                                      quantity-selector=""
                                      button-class="btn btn--card"
                                      source="listing"></falak-add-product-button>
        </div>
    </div>

    <div class="product-card__content">
        {% if product.category %}
            <span class="product-card__category">{{ product.category.name }}</span>
        {% endif %}
        <h3><a class="product-card__link" href="{{ product.url }}">{{ product.name }}</a></h3>
        <p class="product-card__price">{{ product.price }}</p>
    </div>
</div>
