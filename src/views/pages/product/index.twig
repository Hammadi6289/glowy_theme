{#
    Product listing — category, search results, and tag listing all share this shape.
    | Variable    | Type   | Description                                                      |
    | products    | array  | list of product cards                                             |
    | category    | ?array | id, name, url — set when ONE category is selected, which
                             is what a category page is now that /category/{id} is gone |
    | filters     | array  | sidebar options for <falak-filters> (categories, price, rating…) |
    | sort        | string | the active sort key                                              |
    | sorts       | array  | every sort key the listing accepts                               |
    | is_filtered | bool   | true when the shopper narrowed the list                          |
    | priceFilter | array  | min, max (current selection), bounds_min, bounds_max — legacy    |
    | pagination  | array  | page, last_page, per_page, total, from, to                        |
    | query_base  | string | the current query minus `page`, with its own trailing separator  |

    Paging is SERVER-side and lives in the query string beside the filters, so
    page 3 of a filtered listing is one shareable URL. The pager is links, not
    buttons — it keeps working with JavaScript off, and a crawler follows links.
#}
{% extends "layouts.master" %}

{% block title %}{{ category ? category.name : trans('common.products') }} — {{ store.name }}{% endblock %}

{% block content %}
    {% set hasFilters = filters is defined and filters|length > 0 %}
    {% set filtered = is_filtered|default(false) %}

    <div class="container product-listing{{ hasFilters ? ' product-listing--with-sidebar' : '' }}" data-store-currency="{{ store.currency.code|default('SAR') }}">
        {# Seeds the session trail with the category name, so a product
           reached from here shows Home / Category / Product instead of just
           Home / Product — see <falak-breadcrumb>'s own doc comment. #}
        <falak-breadcrumb></falak-breadcrumb>

        <header class="page-head">
            <h1>{{ category ? category.name : trans('common.products') }}</h1>
        </header>

        {# Subcategories circular avatars row #}
        <section class="category-subcategories" data-category-subcategories {% if category %}data-current-category-id="{{ category.id }}"{% endif %} aria-label="{{ trans('common.categories') }}">
            {% set subcats = category and category.children is defined and category.children|length > 0 ? category.children : [] %}
            <div class="category-subcategories__list" data-subcategories-list>
                {% for sub in subcats %}
                    <a href="/products?category_id%5B%5D={{ sub.id }}" class="category-subcard">
                        <span class="category-subcard__avatar">
                            {% if sub.image or sub.image_url %}
                                <img src="{{ sub.image_url|default(sub.image) }}" alt="{{ sub.name }}" loading="lazy">
                            {% else %}
                                <svg class="category-subcard__icon" version="1.1" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
                                    <title>shopping-bag</title>
                                    <path d="M28 10.667h-4v-2.667c0-4.412-3.588-8-8-8s-8 3.588-8 8v2.667h-4c-0.736 0-1.333 0.596-1.333 1.333v13.333c0 3.676 2.991 6.667 6.667 6.667h13.333c3.676 0 6.667-2.991 6.667-6.667v-13.333c0-0.737-0.597-1.333-1.333-1.333zM10.667 8c0-2.941 2.392-5.333 5.333-5.333s5.333 2.392 5.333 5.333v2.667h-10.667zM26.667 25.333c0 2.205-1.795 4-4 4h-13.333c-2.205 0-4-1.795-4-4v-12h2.667v2.667c0 0.737 0.597 1.333 1.333 1.333s1.333-0.596 1.333-1.333v-2.667h10.667v2.667c0 0.737 0.597 1.333 1.333 1.333s1.333-0.596 1.333-1.333v-2.667h2.667z"></path>
                                </svg>
                            {% endif %}
                        </span>
                        <span class="category-subcard__name">{{ sub.name }}</span>
                    </a>
                {% endfor %}
            </div>
        </section>

        <div class="product-listing__layout">
            {% if hasFilters %}
                {# The sidebar. <falak-filters> owns the widgets and writes the
                   selection to the query string (category_id[], min_price,
                   max_price, rating, in_stock) and reloads — so the page's
                   first paint is already filtered and the URL is shareable.
                   On phones it becomes a drawer, opened by the toolbar button. #}
                <aside class="product-listing__sidebar" data-filters-panel aria-label="{{ trans('filters.title') }}">
                    <div class="product-listing__sidebar-actions">
                        <button type="button" class="btn btn-filter-toggle" data-filter-toggle
                                data-text-hide="{{ trans('filters.hide') }}"
                                data-text-show="{{ trans('filters.show') }}"
                                aria-pressed="false"
                                aria-label="{{ trans('filters.hide') }}">
                            <svg class="btn-filter-toggle__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="4" y1="21" x2="4" y2="14"></line>
                                <line x1="4" y1="10" x2="4" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12" y2="3"></line>
                                <line x1="20" y1="21" x2="20" y2="16"></line>
                                <line x1="20" y1="12" x2="20" y2="3"></line>
                                <line x1="1" y1="14" x2="7" y2="14"></line>
                                <line x1="9" y1="8" x2="15" y2="8"></line>
                                <line x1="17" y1="16" x2="23" y2="16"></line>
                            </svg>
                            <span class="btn-filter-toggle__label">{{ trans('filters.hide') }}</span>
                        </button>
                        <h2 class="product-listing__drawer-title">{{ trans('filters.title') }}</h2>
                        <button type="button" class="product-listing__sidebar-close" data-filters-close aria-label="{{ trans('common.close') }}">×</button>
                    </div>

                    <falak-filters filters="{{ filters|json_encode }}"
                                   {% if category %}category-id="{{ category.id }}"{% endif %}></falak-filters>

                    {# Sidebar ad / promo banner #}
                    {% set sidebar_banner_img = theme.settings.get('category_sidebar_image') ?: ('images/category-sidebar-banner.png'|asset) %}
                    {% set sidebar_banner_link = theme.settings.get('category_sidebar_image_link') %}
                    {% set sidebar_banner_text = theme.settings.get('category_sidebar_image_text') %}
                    {% if sidebar_banner_text is iterable %}
                        {% set sidebar_banner_text = sidebar_banner_text[user.language.code] ?: (sidebar_banner_text.ar ?: sidebar_banner_text.en) %}
                    {% endif %}
                    {% if not sidebar_banner_text %}
                        {% set sidebar_banner_text = theme.is_rtl ? 'خصومات بلا حدود' : 'Endless Discounts' %}
                    {% endif %}
                    {% if sidebar_banner_img %}
                        <div class="product-listing__sidebar-banner">
                            {% if sidebar_banner_link %}
                                <a href="{{ sidebar_banner_link }}" class="product-listing__sidebar-banner-link">
                                    <img src="{{ sidebar_banner_img }}" alt="{{ sidebar_banner_text }}" loading="lazy">
                                    {% if sidebar_banner_text %}
                                        <div class="product-listing__sidebar-banner-overlay">
                                            <span class="product-listing__sidebar-banner-text">{{ sidebar_banner_text }}</span>
                                        </div>
                                    {% endif %}
                                </a>
                            {% else %}
                                <div class="product-listing__sidebar-banner-media">
                                    <img src="{{ sidebar_banner_img }}" alt="{{ sidebar_banner_text }}" loading="lazy">
                                    {% if sidebar_banner_text %}
                                        <div class="product-listing__sidebar-banner-overlay">
                                            <span class="product-listing__sidebar-banner-text">{{ sidebar_banner_text }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </aside>
                <div class="product-listing__backdrop" data-filters-backdrop hidden></div>
            {% endif %}

            <div class="product-listing__main">
                <div class="product-listing__toolbar">
                    <div class="product-listing__toolbar-start">
                        <h2 class="product-listing__heading-title">
                            {% if category %}
                                {{ category.name }}
                                {% if pagination.total|default(0) > 0 %}
                                    <span class="product-listing__heading-count">- {{ pagination.total }} {{ trans('common.products_count') }}</span>
                                {% endif %}
                            {% else %}
                                {{ trans('common.products') }}
                                {% if pagination.total|default(0) > 0 %}
                                    <span class="product-listing__heading-count">- {{ pagination.total }} {{ trans('common.products_count') }}</span>
                                {% endif %}
                            {% endif %}
                        </h2>
                    </div>

                    <div class="product-listing__toolbar-controls">
                        {% if hasFilters %}
                            <button type="button" class="btn btn--outline product-listing__filters-trigger" data-filters-open>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="4" y1="21" x2="4" y2="14"></line>
                                    <line x1="4" y1="10" x2="4" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12" y2="3"></line>
                                    <line x1="20" y1="21" x2="20" y2="16"></line>
                                    <line x1="20" y1="12" x2="20" y2="3"></line>
                                    <line x1="1" y1="14" x2="7" y2="14"></line>
                                    <line x1="9" y1="8" x2="15" y2="8"></line>
                                    <line x1="17" y1="16" x2="23" y2="16"></line>
                                </svg>
                                <span>{{ trans('filters.title') }}</span>
                                {% if filtered %} <span class="product-listing__filters-dot" aria-hidden="true"></span>{% endif %}
                            </button>
                        {% endif %}

                        <label class="product-listing__sort">
                            <span>{{ trans('common.sort') }}</span>
                            <select class="f-input" data-sort>
                                {% for key in sorts|default(['newest', 'price_asc', 'price_desc', 'name']) %}
                                    <option value="{{ key }}" {{ (sort|default('newest')) == key ? 'selected' : '' }}>{{ trans('sort.' ~ key) }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                </div>

                {# Selected filter pills strip matching reference theme #}
                <div class="product-listing__selected-strip" data-selected-filters-strip hidden>
                    <div class="product-listing__selected-pills" data-selected-pills></div>
                    <button type="button" class="product-listing__clear-all" data-clear-all-filters>
                        {{ trans('filters.clear_all')|default('Clear All') }}
                    </button>
                </div>

                {% if products|length > 0 %}
                    <div class="product-grid">
                        {% for product in products %}
                            {% include 'pages.partials.product-card' %}
                        {% endfor %}
                    </div>

                    {# ----------------------------------------------- pager #}
                    {% if pagination.last_page|default(1) > 1 %}
                        <nav class="pager" aria-label="{{ trans('listing.pagination') }}">
                            {% if pagination.page > 1 %}
                                <a class="pager__step" href="?{{ query_base }}page={{ pagination.page - 1 }}"
                                   rel="prev" data-page-link>{{ trans('common.previous') }}</a>
                            {% else %}
                                <span class="pager__step is-disabled">{{ trans('common.previous') }}</span>
                            {% endif %}

                            {#
                                A window around the current page, not every page:
                                a 40-page catalogue would otherwise render 40
                                links. max()/min() are NOT in the Twig sandbox's
                                function allowlist (range, trans, hook,
                                falak_currency) — calling them throws — so the
                                bounds are clamped with ternaries instead.
                            #}
                            {% set window_start = pagination.page - 2 < 1 ? 1 : pagination.page - 2 %}
                            {% set window_end = pagination.page + 2 > pagination.last_page ? pagination.last_page : pagination.page + 2 %}

                            {% if window_start > 1 %}
                                <a class="pager__page" href="?{{ query_base }}page=1" data-page-link>1</a>
                                {% if window_start > 2 %}<span class="pager__gap">…</span>{% endif %}
                            {% endif %}

                            {% for n in range(window_start, window_end) %}
                                {% if n == pagination.page %}
                                    <span class="pager__page is-current" aria-current="page">{{ n }}</span>
                                {% else %}
                                    <a class="pager__page" href="?{{ query_base }}page={{ n }}" data-page-link>{{ n }}</a>
                                {% endif %}
                            {% endfor %}

                            {% if window_end < pagination.last_page %}
                                {% if window_end < pagination.last_page - 1 %}<span class="pager__gap">…</span>{% endif %}
                                <a class="pager__page" href="?{{ query_base }}page={{ pagination.last_page }}"
                                   data-page-link>{{ pagination.last_page }}</a>
                            {% endif %}

                            {% if pagination.page < pagination.last_page %}
                                <a class="pager__step" href="?{{ query_base }}page={{ pagination.page + 1 }}"
                                   rel="next" data-page-link>{{ trans('common.next') }}</a>
                            {% else %}
                                <span class="pager__step is-disabled">{{ trans('common.next') }}</span>
                            {% endif %}
                        </nav>
                    {% endif %}
                {% else %}
                    {#
                        A filtered-out list offers "reset"; an empty store offers
                        the way home.

                        Reset returns to the CATEGORY when there is one, not to
                        the bare path. A category now lives in the query string
                        (`category_id[]`, since /category/{id} is gone), so `?`
                        would drop the category along with the filters and
                        answer "no dresses under 50" with the whole catalogue.
                    #}
                    <div class="empty-state product-listing__empty">
                        <div class="empty-state__icon-wrap">
                            <svg class="empty-state__illustration" viewBox="0 0 260 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M85 35 C145 20, 210 40, 215 95 C220 150, 160 175, 115 170 C70 165, 45 130, 50 85 C55 45, 60 40, 85 35 Z" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 14%, #ffffff)" />
                                <circle cx="48" cy="115" r="5" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 35%, transparent)" stroke-width="2" fill="none" />
                                <circle cx="56" cy="65" r="10" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 30%, transparent)" stroke-width="2" fill="none" />
                                <circle cx="215" cy="48" r="8" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 30%, transparent)" stroke-width="2" fill="none" />
                                <circle cx="68" cy="180" r="3.5" fill="#e59866" />
                                <path d="M175 185 C190 190, 200 175, 210 180 C215 182, 222 175, 228 178" stroke="#e59866" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />
                                <circle cx="225" cy="160" r="11" fill="#e59866" />
                                <path d="M221 156 L229 164 M229 156 L221 164" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                                <g class="empty-state__cart-group">
                                    <path d="M68 76 H78 L92 142 C93 147, 97 150, 102 150 H184 C189 150, 193 147, 194 142 L206 95 H83" stroke="var(--color-primary, #ce5a67)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.2" />
                                    <path d="M68 76 H78 L92 142 C93 147, 97 150, 102 150 H184 C189 150, 193 147, 194 142 L206 95 H83" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 38%, #ffffff)" />
                                    <rect x="106" y="104" width="46" height="6.5" rx="3.25" fill="#ffffff" />
                                    <rect x="112" y="120" width="46" height="6.5" rx="3.25" fill="#ffffff" />
                                    <circle cx="112" cy="165" r="13" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 42%, #ffffff)" />
                                    <circle cx="174" cy="165" r="13" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 42%, #ffffff)" />
                                    <circle cx="196" cy="90" r="19" fill="var(--color-primary, #ce5a67)" />
                                    <path d="M189 83 L203 97 M203 83 L189 97" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" />
                                </g>
                            </svg>
                        </div>
                        <p class="empty-state__text">{{ trans('common.no_products') }}</p>
                        <a href="{{ filtered ? (category ? category.url : '?') : store.url }}" class="btn btn--outline">
                            {{ filtered ? trans('filters.reset') : trans('common.back_home') }}
                        </a>
                    </div>

                    {#
                        An empty CATEGORY is not an empty store, so offer a way onward
                        rather than a dead end. Guarded on `category` on purpose: with
                        no filter the listing is empty because the store itself is, and
                        the component would render a second empty message under the
                        first one.
                    #}
                    {% if category and not filtered %}
                        <section class="product-listing__fallback">
                            <h2>{{ trans('product.other_products') }}</h2>
                            <falak-products-list limit="4" columns="4" source="listing.empty"></falak-products-list>
                        </section>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
