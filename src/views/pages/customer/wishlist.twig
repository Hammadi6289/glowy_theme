{#
    Wishlist — server-rendered for the signed-in customer (auth cookie) and
    for a guest (the browser's guest token), the same list the hearts toggle.
    | Variable | Type  | Description                             |
    | products | array | product-card shape (mapProduct)         |
#}
{% extends "layouts.customer" %}

{% set account_page = 'wishlist' %}

{% block title %}{{ trans('account.wishlist') }} — {{ store.name }}{% endblock %}

{% block account_content %}
    <h1>{{ trans('account.wishlist') }}</h1>
    {% if products|default([])|length > 0 %}
        <p class="page-head__meta">{{ trans('cart.items_count', {count: products|length}) }}</p>
    {% endif %}

    {% if products|default([])|length > 0 %}
        <div class="product-grid">
            {% for product in products %}
                {% include 'pages.partials.product-card' %}
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state account__empty-state">
            <div class="empty-state__icon-wrap">
                <svg class="empty-state__illustration" viewBox="0 0 260 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <!-- Soft Theme Blob -->
                    <path d="M85 35 C145 20, 210 40, 215 95 C220 150, 160 175, 115 170 C70 165, 45 130, 50 85 C55 45, 60 40, 85 35 Z" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 14%, #ffffff)" />
                    <circle cx="48" cy="115" r="5" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 35%, transparent)" stroke-width="2" fill="none" />
                    <circle cx="56" cy="65" r="10" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 30%, transparent)" stroke-width="2" fill="none" />
                    <circle cx="215" cy="48" r="8" stroke="color-mix(in srgb, var(--color-primary, #ce5a67) 30%, transparent)" stroke-width="2" fill="none" />
                    <circle cx="68" cy="180" r="3.5" fill="#e59866" />
                    <path d="M175 185 C190 190, 200 175, 210 180 C215 182, 222 175, 228 178" stroke="#e59866" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />
                    <circle cx="225" cy="160" r="11" fill="#e59866" />
                    <path d="M221 156 L229 164 M229 156 L221 164" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />

                    <!-- Floating Theme Primary Heart -->
                    <g class="empty-state__heart-group">
                        <!-- Soft Back Shadow -->
                        <path d="M130 168 C130 168 62 125 62 82 C62 58 82 40 106 40 C120 40 128 48 130 52 C132 48 140 40 154 40 C178 40 198 58 198 82 C198 125 130 168 130 168 Z" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 25%, #ffffff)" opacity="0.4" />
                        <!-- Main Heart -->
                        <path d="M130 160 C130 160 68 120 68 80 C68 58 86 42 108 42 C121 42 127 50 130 54 C133 50 139 42 152 42 C174 42 192 58 192 80 C192 120 130 160 130 160 Z" fill="color-mix(in srgb, var(--color-primary, #ce5a67) 85%, #ffffff)" stroke="var(--color-primary, #ce5a67)" stroke-width="4.5" stroke-linejoin="round" />
                        <!-- Heart Highlights -->
                        <path d="M88 64 C80 72 78 84 80 94" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
                        <circle cx="88" cy="58" r="2.5" fill="#ffffff" />
                        <!-- Little Floating Sparkle -->
                        <path d="M185 45 L189 53 L197 57 L189 61 L185 69 L181 61 L173 57 L181 53 Z" fill="#e59866" />
                    </g>
                </svg>
            </div>
            <p class="empty-state__text">{{ trans('account.no_wishlist') }}</p>
            <a href="/products" class="btn btn--primary">{{ trans('cart.start_shopping') }}</a>
        </div>
    {% endif %}
{% endblock %}
