{#
    Blog listing — Jalawi layout: breadcrumb, featured hero article,
    and responsive grid of articles matching the Falak dashboard.

    | Variable | Type  | Description                                                    |
    | articles | array | each: title, excerpt, image, url, created_at, author — pending |
    | blogs    | array | platform alternate collection                                  |
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('blog.title') }} — {{ store.name }}{% endblock %}

{% block content %}
    {% set raw_list = articles|default(blogs|default(posts|default([]))) %}
    {% set list = raw_list.data is defined ? raw_list.data : raw_list %}
    {% set crumbs = [
        { title: trans('common.home'), url: store.url },
        { title: trans('blog.title'), url: '/blogs' }
    ] %}

    <div class="container blog-page">
        <nav class="blog-page__crumbs">
            <falak-breadcrumb items="{{ crumbs|json_encode }}"></falak-breadcrumb>
        </nav>

        <div class="blog-feed" data-blog-feed>
            {% if list|length > 0 %}
                {# Featured: the newest article #}
                {% set featured = list[0] %}
                {% set feat_url = featured.url|default('/blogs/' ~ (featured.slug|default(featured.id))) %}
                {% set feat_img = featured.featured_image_url|default(featured.image_url|default(featured.image|default(null))) %}
                {% set feat_author = featured.author_name|default(featured.author.name|default(null)) %}
                {% set feat_date = featured.published_at|default(featured.created_at|default(null)) %}

                <div class="blog-feature">
                    <a class="blog-feature__media" href="{{ feat_url }}" tabindex="-1" aria-hidden="true">
                        {% if feat_img %}<img src="{{ feat_img }}" alt="{{ featured.title }}" loading="eager">{% else %}<div class="blog-placeholder-img"></div>{% endif %}
                    </a>
                    <div class="blog-feature__body">
                        <div class="blog-meta">
                            {% if feat_date %}
                                <span class="blog-meta__item">
                                    <svg class="blog-meta__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12ZM4 10h16M8 3v4M16 3v4"/></svg>
                                    <time datetime="{{ feat_date|date('Y-m-d') }}">{{ feat_date|date('j F Y') }}</time>
                                </span>
                            {% endif %}
                            {% if feat_author and (featured.show_author is not defined or featured.show_author) %}
                                <span class="blog-meta__item">
                                    <svg class="blog-meta__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0"/></svg>
                                    <span>{{ feat_author }}</span>
                                </span>
                            {% endif %}
                        </div>
                        <h2 class="blog-feature__title"><a href="{{ feat_url }}">{{ featured.title }}</a></h2>
                        {% if featured.excerpt|default(null) %}<p class="blog-feature__excerpt">{{ featured.excerpt }}</p>{% endif %}
                        <a class="blog-read-more" href="{{ feat_url }}">
                            <span>{{ trans('blog.read_more') }}</span>
                            <svg class="blog-read-more__arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                        </a>
                    </div>
                </div>

                {% if list|length > 1 %}
                    <div class="blog-list">
                        {% for article in list %}
                            {% if loop.index > 1 %}
                                {% set art_url = article.url|default('/blogs/' ~ (article.slug|default(article.id))) %}
                                {% set art_img = article.featured_image_url|default(article.image_url|default(article.image|default(null))) %}
                                {% set art_author = article.author_name|default(article.author.name|default(null)) %}
                                {% set art_date = article.published_at|default(article.created_at|default(null)) %}

                                <article class="blog-entry">
                                    <a class="blog-entry__media" href="{{ art_url }}" tabindex="-1" aria-hidden="true">
                                        {% if art_img %}<img src="{{ art_img }}" alt="{{ article.title }}" loading="lazy">{% else %}<div class="blog-placeholder-img"></div>{% endif %}
                                    </a>
                                    <div class="blog-entry__body">
                                        <div class="blog-meta">
                                            {% if art_date %}
                                                <span class="blog-meta__item">
                                                    <svg class="blog-meta__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12ZM4 10h16M8 3v4M16 3v4"/></svg>
                                                    <time datetime="{{ art_date|date('Y-m-d') }}">{{ art_date|date('j F Y') }}</time>
                                                </span>
                                            {% endif %}
                                            {% if art_author and (article.show_author is not defined or article.show_author) %}
                                                <span class="blog-meta__item">
                                                    <svg class="blog-meta__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0"/></svg>
                                                    <span>{{ art_author }}</span>
                                                </span>
                                            {% endif %}
                                        </div>
                                        <h3 class="blog-entry__title"><a href="{{ art_url }}">{{ article.title }}</a></h3>
                                        {% if article.excerpt|default(null) %}<p class="blog-entry__excerpt">{{ article.excerpt }}</p>{% endif %}
                                        <a class="blog-read-more" href="{{ art_url }}">
                                            <span>{{ trans('blog.read_more') }}</span>
                                            <svg class="blog-read-more__arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                                        </a>
                                    </div>
                                </article>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                {# Client-side hydration from /api/storefront/blogs will populate here automatically #}
                <div class="blog-loading">
                    <div class="blog-spinner"></div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
